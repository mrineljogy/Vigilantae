# Optional: required for a hosted deployment with shared, persistent records.
# Example PostgreSQL format (do not commit your real value):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional: enables email notifications when a potential match is found.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-app-password
# NOTIFY_EMAIL=operations@example.com
